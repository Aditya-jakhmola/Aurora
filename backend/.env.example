# Copy this file to ".env" and fill it in.  NEVER commit ".env" to Git.

PORT=5000

# "development" on your laptop, "production" on a real server.
NODE_ENV=development

# Local Docker database (see docker-compose.yml).
# On a hosting provider, use the connection string it gives you instead.
DATABASE_URL="postgresql://aurora:aurora_dev_password@localhost:5433/aurora?schema=public"

# Signs login tokens. In production this MUST be a random string of 32+ characters
# or the server refuses to start.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

AUDIUS_API_URL=https://api.audius.co/v1
# Optional. Never put this in any frontend file.
# AUDIUS_BEARER_TOKEN=

# How many reverse proxies sit in front of the app. Use 1 on Render / Railway /
# Heroku so rate limiting sees each visitor's real address. Leave empty locally.
# TRUST_PROXY=

# Other websites allowed to call the API (comma separated). Leave empty — Aurora
# serves its own frontend, so nothing else needs access.
# CORS_ORIGINS=

# Set to "report-only" to LOG Content-Security-Policy problems in the browser
# console instead of blocking anything (handy if something looks broken).
# CSP_MODE=
